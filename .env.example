# Copy to .env on the server (never commit .env), then: chmod 600 .env
# Full guide: docs/DEPLOY.md

# --- Content (Phase 1) ---
ANTHROPIC_API_KEY=
# gemini | openai | unsplash | library | placeholder
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Free sources tried in order when the main one fails (quota, no billing, no key):
#   unsplash = Unsplash search (free key: unsplash.com/developers -> New Application -> Access Key)
#   library  = your pictures in data/images/scenes and data/images/subjects (data/images/README.md)
#   none     = no fallback (fail if the main source fails)
IMAGE_FALLBACK=unsplash,library
UNSPLASH_ACCESS_KEY=
# true = sample text + placeholder images, no paid calls (for trying the system)
DEMO_MODE=false

# Budget caps in USD (enforced by code)
DAILY_BUDGET_USD=0.60
MONTHLY_BUDGET_USD=18.00

# --- Dashboard login (run: instapost admin-setup) ---
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# https://admin.yourdomain.com once Cloudflare Tunnel is set up
PUBLIC_BASE_URL=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Meta (docs/SETUP_META_YOUTUBE.md) ---
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- YouTube ---
# OAuth client JSON goes in secrets/youtube_client_secret.json, then run: instapost youtube-login
# Switch to public after the YouTube API audit is approved.
YOUTUBE_PRIVACY=private
# auto = reels go to Instagram by API; app = you post reels in the Instagram app with a
# trending sound (Telegram sends the package at the slot time; see data/music/README.md)
INSTAGRAM_REELS=auto
# plate = reels printed onto real book photos (dashboard: Backgrounds); classic = drawn book page
REEL_STYLE=plate
# true = when no library drawing fits a post, Gemini makes one (~$0.04, kept for reuse)
DRAWINGS_GENERATE=true
# Stories (one line + poll) are written by the small model to save cost; uncomment to use Sonnet.
# STORY_WRITER_MODEL=claude-sonnet-5-5

# --- Media hosting for Instagram/Facebook (Cloudflare R2) ---
MEDIA_HOST=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=instapost-media
