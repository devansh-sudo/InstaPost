[Unit]
Description=InstaPost worker (scheduler, publisher, Telegram bot)
After=network-online.target

[Service]
User=instapost
WorkingDirectory=/opt/instapost
ExecStart=/opt/instapost/.venv/bin/instapost worker
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/instapost/state /opt/instapost/output /opt/instapost/secrets
UMask=0077

[Install]
WantedBy=multi-user.target
