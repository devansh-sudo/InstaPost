[Unit]
Description=InstaPost dashboard
After=network-online.target
# Waits for the disk the app lives on (e.g. a mounted volume).
RequiresMountsFor=/opt/instapost

[Service]
User=instapost
WorkingDirectory=/opt/instapost
ExecStart=/opt/instapost/.venv/bin/instapost web
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/instapost/state /opt/instapost/output /opt/instapost/secrets
UMask=0077

[Install]
WantedBy=multi-user.target
