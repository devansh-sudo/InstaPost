.venv/
.uv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets: never commit
.env
.env.*
!.env.example
secrets/

# Generated content and runtime state
output/
state/

# Docker deploy settings written by deploy/docker.sh
deploy/compose.env
deploy/.update.lock

# Your own pictures for the library image source (data/images/README.md)
data/images/**
!data/images/README.md
!data/images/scenes/
!data/images/subjects/
!data/images/*/.gitkeep

# Your own music tracks (data/music/README.md)
data/music/**
!data/music/README.md
!data/music/.gitkeep
